# Copy to .env.local for local development. .env.local is gitignored.
#
# Vite only exposes variables that start with VITE_, and it inlines them into
# the bundle at BUILD time - so everything here is public once the site ships.
# Never put a secret in this file or in Vercel's environment for this project.
# The Razorpay key id below is meant to be public; the Razorpay *secret* lives
# only on the backend.

# Where the Spring Boot API is.
#   local:      http://localhost:8081
#   production: https://<your-service>.up.railway.app
VITE_API_URL=http://localhost:8081
